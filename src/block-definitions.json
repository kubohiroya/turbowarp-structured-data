{
  "extensionName": "Structured Data",
  "menus": {
    "documentTreePositions": {"acceptReporters": false, "items": ["without positions", "with positions"]}
  },
  "blocks": [
    {
      "opcode": "parseJson", "blockType": "COMMAND", "text": "parse JSON [TEXT] as [NAME]", "description": "Parse JSON text into the target-local structured data namespace.",
      "arguments": {"TEXT": {"type": "STRING", "defaultValue": "{\"name\":\"TurboWarp\"}"}, "NAME": {"type": "STRING", "defaultValue": "data"}},
      "resultType": "void", "effect": "state", "immutable": true, "errors": ["INVALID_JSON", "INVALID_NAME", "PARSE_LIMIT_EXCEEDED"],
      "server": {"supported": true, "irOperation": "structuredData.parseJson"}
    },
    {
      "opcode": "parseYaml", "blockType": "COMMAND", "text": "parse YAML [TEXT] as [NAME]", "description": "Parse safe YAML text into the target-local structured data namespace.",
      "arguments": {"TEXT": {"type": "STRING", "defaultValue": "name: TurboWarp"}, "NAME": {"type": "STRING", "defaultValue": "data"}},
      "resultType": "void", "effect": "state", "immutable": true, "errors": ["INVALID_YAML", "INVALID_NAME", "PARSE_LIMIT_EXCEEDED"],
      "server": {"supported": true, "irOperation": "structuredData.parseYaml"}
    },
    {
      "opcode": "copyDocumentTree", "blockType": "COMMAND", "text": "copy document [DOCUMENT] at [LOCATION] [POSITIONS] as [NAME]", "description": "Copy a Document Data document, or the part at a location, into the target-local structured data namespace.",
      "arguments": {"DOCUMENT": {"type": "STRING", "defaultValue": "page"}, "LOCATION": {"type": "STRING", "defaultValue": "$"}, "POSITIONS": {"type": "STRING", "defaultValue": "without positions", "menu": "documentTreePositions"}, "NAME": {"type": "STRING", "defaultValue": "tree"}},
      "resultType": "void", "effect": "state", "immutable": true, "errors": ["INVALID_NAME", "DATA_NOT_FOUND", "INVALID_PATH", "PATH_NOT_FOUND", "TYPE_MISMATCH", "PARSE_LIMIT_EXCEEDED"],
      "server": {"supported": false}
    },
    {
      "opcode": "toJson", "blockType": "REPORTER", "text": "to JSON [NAME]", "description": "Render named structured data as canonical JSON.",
      "arguments": {"NAME": {"type": "STRING", "defaultValue": "data"}},
      "resultType": "jsonText", "effect": "pure", "immutable": true, "errors": ["INVALID_NAME", "DATA_NOT_FOUND"],
      "server": {"supported": true, "irOperation": "structuredData.toJson"}
    },
    {
      "opcode": "toYaml", "blockType": "REPORTER", "text": "to YAML [NAME]", "description": "Render named structured data as deterministic YAML.",
      "arguments": {"NAME": {"type": "STRING", "defaultValue": "data"}},
      "resultType": "yamlText", "effect": "pure", "immutable": true, "errors": ["INVALID_NAME", "DATA_NOT_FOUND"],
      "server": {"supported": true, "irOperation": "structuredData.toYaml"}
    },
    {
      "opcode": "hasStructuredData", "blockType": "BOOLEAN", "text": "structured data [NAME] exists?", "description": "Report whether the current target has named structured data.",
      "arguments": {"NAME": {"type": "STRING", "defaultValue": "data"}},
      "resultType": "boolean", "effect": "pure", "immutable": true, "errors": ["INVALID_NAME"],
      "server": {"supported": true, "irOperation": "structuredData.hasData"}
    },
    {
      "opcode": "deleteStructuredData", "blockType": "COMMAND", "text": "delete structured data [NAME]", "description": "Delete named structured data from the current target.",
      "arguments": {"NAME": {"type": "STRING", "defaultValue": "data"}},
      "resultType": "void", "effect": "state", "immutable": true, "errors": ["INVALID_NAME", "DATA_NOT_FOUND"],
      "server": {"supported": true, "irOperation": "structuredData.deleteData"}
    },
    {
      "opcode": "getJsonAtPath", "blockType": "REPORTER", "text": "get JSON from [NAME] at path [PATH]", "description": "Return a named value at a path as JSON.",
      "arguments": {"NAME": {"type": "STRING", "defaultValue": "data"}, "PATH": {"type": "STRING", "defaultValue": "$.name", "normalizesTo": "pathSegments"}},
      "resultType": "jsonText", "effect": "pure", "immutable": true, "errors": ["INVALID_NAME", "DATA_NOT_FOUND", "INVALID_PATH", "PATH_NOT_FOUND", "TYPE_MISMATCH", "INDEX_OUT_OF_RANGE"],
      "server": {"supported": true, "irOperation": "structuredData.get"}
    },
    {
      "opcode": "getTextAtPath", "blockType": "REPORTER", "text": "text from [NAME] at path [PATH]", "description": "Return a string, number, or boolean at a path as text; strings have no JSON quotes.",
      "arguments": {"NAME": {"type": "STRING", "defaultValue": "data"}, "PATH": {"type": "STRING", "defaultValue": "$.name", "normalizesTo": "pathSegments"}},
      "resultType": "string", "effect": "pure", "immutable": true, "errors": ["INVALID_NAME", "DATA_NOT_FOUND", "INVALID_PATH", "PATH_NOT_FOUND", "TYPE_MISMATCH", "INDEX_OUT_OF_RANGE"],
      "server": {"supported": true, "irOperation": "structuredData.getText"}
    },
    {
      "opcode": "hasPath", "blockType": "BOOLEAN", "text": "structured data [NAME] has path [PATH]?", "description": "Report whether a path exists in named structured data.",
      "arguments": {"NAME": {"type": "STRING", "defaultValue": "data"}, "PATH": {"type": "STRING", "defaultValue": "$.name", "normalizesTo": "pathSegments"}},
      "resultType": "boolean", "effect": "pure", "immutable": true, "errors": ["INVALID_NAME", "DATA_NOT_FOUND", "INVALID_PATH", "TYPE_MISMATCH"],
      "server": {"supported": true, "irOperation": "structuredData.has"}
    },
    {
      "opcode": "setJsonAtPath", "blockType": "COMMAND", "text": "set [NAME] at path [PATH] to JSON [VALUE]", "description": "Immutably update a named value and replace its binding.",
      "arguments": {"NAME": {"type": "STRING", "defaultValue": "data"}, "PATH": {"type": "STRING", "defaultValue": "$.name", "normalizesTo": "pathSegments"}, "VALUE": {"type": "STRING", "defaultValue": "\"Scratch\""}},
      "resultType": "void", "effect": "state", "immutable": true, "errors": ["INVALID_NAME", "DATA_NOT_FOUND", "INVALID_JSON", "INVALID_PATH", "PATH_NOT_FOUND", "TYPE_MISMATCH", "INDEX_OUT_OF_RANGE", "SCHEMA_VALIDATION_FAILED"],
      "server": {"supported": true, "irOperation": "structuredData.set"}
    },
    {
      "opcode": "deleteAtPath", "blockType": "COMMAND", "text": "delete path [PATH] from [NAME]", "description": "Immutably delete a path and replace its named binding.",
      "arguments": {"NAME": {"type": "STRING", "defaultValue": "data"}, "PATH": {"type": "STRING", "defaultValue": "$.name", "normalizesTo": "pathSegments"}},
      "resultType": "void", "effect": "state", "immutable": true, "errors": ["INVALID_NAME", "DATA_NOT_FOUND", "INVALID_PATH", "PATH_NOT_FOUND", "TYPE_MISMATCH", "INDEX_OUT_OF_RANGE", "SCHEMA_VALIDATION_FAILED"],
      "server": {"supported": true, "irOperation": "structuredData.delete"}
    },
    {
      "opcode": "keysAtPath", "blockType": "REPORTER", "text": "keys in [NAME] at path [PATH]", "description": "Return sorted object keys as JSON.",
      "arguments": {"NAME": {"type": "STRING", "defaultValue": "data"}, "PATH": {"type": "STRING", "defaultValue": "$", "normalizesTo": "pathSegments"}},
      "resultType": "jsonText", "effect": "pure", "immutable": true, "errors": ["INVALID_NAME", "DATA_NOT_FOUND", "INVALID_PATH", "PATH_NOT_FOUND", "TYPE_MISMATCH", "INDEX_OUT_OF_RANGE"],
      "server": {"supported": true, "irOperation": "structuredData.keys"}
    },
    {
      "opcode": "lengthAtPath", "blockType": "REPORTER", "text": "length of array in [NAME] at path [PATH]", "description": "Return the array length.",
      "arguments": {"NAME": {"type": "STRING", "defaultValue": "data"}, "PATH": {"type": "STRING", "defaultValue": "$", "normalizesTo": "pathSegments"}},
      "resultType": "number", "effect": "pure", "immutable": true, "errors": ["INVALID_NAME", "DATA_NOT_FOUND", "INVALID_PATH", "PATH_NOT_FOUND", "TYPE_MISMATCH", "INDEX_OUT_OF_RANGE"],
      "server": {"supported": true, "irOperation": "structuredData.length"}
    },
    {
      "opcode": "forEachAtPath", "blockType": "LOOP", "text": "for each in [NAME] at path [PATH] max [MAX]", "description": "Iterate named data deterministically with a static maximum.",
      "arguments": {"NAME": {"type": "STRING", "defaultValue": "data"}, "PATH": {"type": "STRING", "defaultValue": "$", "normalizesTo": "pathSegments"}, "MAX": {"type": "NUMBER", "defaultValue": 100, "staticLiteral": true, "minimum": 1, "maximum": 1000}},
      "resultType": "void", "effect": "control", "immutable": true, "errors": ["INVALID_NAME", "DATA_NOT_FOUND", "INVALID_PATH", "PATH_NOT_FOUND", "TYPE_MISMATCH", "INDEX_OUT_OF_RANGE", "ITERATION_LIMIT_EXCEEDED"],
      "server": {"supported": true, "irOperation": "structuredData.forEach"}
    },
    {
      "opcode": "currentKey", "blockType": "REPORTER", "text": "current key", "description": "Return the current object key or array index string.",
      "arguments": {}, "resultType": "string", "effect": "control", "immutable": true, "errors": ["ITERATION_CONTEXT_REQUIRED"],
      "server": {"supported": true, "irOperation": "structuredData.currentKey"}
    },
    {
      "opcode": "currentIndex", "blockType": "REPORTER", "text": "current index", "description": "Return the zero-based iteration number.",
      "arguments": {}, "resultType": "number", "effect": "control", "immutable": true, "errors": ["ITERATION_CONTEXT_REQUIRED"],
      "server": {"supported": true, "irOperation": "structuredData.currentIndex"}
    },
    {
      "opcode": "currentValueJson", "blockType": "REPORTER", "text": "current value JSON", "description": "Return the current iteration value as JSON.",
      "arguments": {}, "resultType": "jsonText", "effect": "control", "immutable": true, "errors": ["ITERATION_CONTEXT_REQUIRED"],
      "server": {"supported": true, "irOperation": "structuredData.currentValue"}
    },
    {
      "opcode": "currentJsonAtPath", "blockType": "REPORTER", "text": "current value at path [PATH]", "description": "Return the value at a path inside the current iteration value as JSON.",
      "arguments": {"PATH": {"type": "STRING", "defaultValue": "$", "normalizesTo": "pathSegments"}},
      "resultType": "jsonText", "effect": "control", "immutable": true, "errors": ["ITERATION_CONTEXT_REQUIRED", "INVALID_PATH", "PATH_NOT_FOUND", "TYPE_MISMATCH", "INDEX_OUT_OF_RANGE"],
      "server": {"supported": true, "irOperation": "structuredData.currentGet"}
    },
    {
      "opcode": "currentTextAtPath", "blockType": "REPORTER", "text": "current text at path [PATH]", "description": "Return a string, number, or boolean at a path inside the current iteration value as text.",
      "arguments": {"PATH": {"type": "STRING", "defaultValue": "$", "normalizesTo": "pathSegments"}},
      "resultType": "string", "effect": "control", "immutable": true, "errors": ["ITERATION_CONTEXT_REQUIRED", "INVALID_PATH", "PATH_NOT_FOUND", "TYPE_MISMATCH", "INDEX_OUT_OF_RANGE"],
      "server": {"supported": true, "irOperation": "structuredData.currentGetText"}
    },
    {
      "opcode": "defineSchema", "blockType": "COMMAND", "text": "define schema [SCHEMA_ID] version [VERSION] from JSON [TEXT]", "description": "Register a reusable Schema document from JSON text under a stable id and version.",
      "arguments": {"SCHEMA_ID": {"type": "STRING", "defaultValue": "sensor.reading"}, "VERSION": {"type": "STRING", "defaultValue": "1.0.0"}, "TEXT": {"type": "STRING", "defaultValue": "{\"type\":\"object\",\"properties\":{\"name\":{\"type\":\"string\"}},\"required\":[\"name\"]}"}},
      "resultType": "void", "effect": "state", "immutable": true, "errors": ["INVALID_SCHEMA"],
      "server": {"supported": true, "irOperation": "structuredData.defineSchema"}
    },
    {
      "opcode": "beginSchema", "blockType": "COMMAND", "text": "begin schema [SCHEMA_ID] version [VERSION] extra properties [EXTRA]", "description": "Start a visual Schema definition for an object, replacing any open draft.",
      "arguments": {"SCHEMA_ID": {"type": "STRING", "defaultValue": "sensor.reading"}, "VERSION": {"type": "STRING", "defaultValue": "1.0.0"}, "EXTRA": {"type": "STRING", "defaultValue": "reject"}},
      "resultType": "void", "effect": "state", "immutable": true, "errors": ["INVALID_SCHEMA"],
      "server": {"supported": true, "irOperation": "structuredData.beginSchema"}
    },
    {
      "opcode": "addSchemaProperty", "blockType": "COMMAND", "text": "add property [PROPERTY] type [TYPE] [REQUIRED]", "description": "Add one property of the subset types to the open visual Schema draft.",
      "arguments": {"PROPERTY": {"type": "STRING", "defaultValue": "name"}, "TYPE": {"type": "STRING", "defaultValue": "string"}, "REQUIRED": {"type": "STRING", "defaultValue": "required"}},
      "resultType": "void", "effect": "state", "immutable": true, "errors": ["INVALID_SCHEMA"],
      "server": {"supported": true, "irOperation": "structuredData.addSchemaProperty"}
    },
    {
      "opcode": "commitSchema", "blockType": "COMMAND", "text": "commit schema", "description": "Register the open visual draft as the same canonical Schema a text definition produces.",
      "arguments": {}, "resultType": "void", "effect": "state", "immutable": true, "errors": ["INVALID_SCHEMA"],
      "server": {"supported": true, "irOperation": "structuredData.commitSchema"}
    },
    {
      "opcode": "hasSchema", "blockType": "BOOLEAN", "text": "schema [SCHEMA_ID] version [VERSION] exists?", "description": "Report whether the current target has that Schema registered.",
      "arguments": {"SCHEMA_ID": {"type": "STRING", "defaultValue": "sensor.reading"}, "VERSION": {"type": "STRING", "defaultValue": "1.0.0"}},
      "resultType": "boolean", "effect": "pure", "immutable": true, "errors": ["INVALID_SCHEMA"],
      "server": {"supported": true, "irOperation": "structuredData.hasSchema"}
    },
    {
      "opcode": "deleteSchema", "blockType": "COMMAND", "text": "delete schema [SCHEMA_ID] version [VERSION]", "description": "Delete a registered Schema; bindings already validated against it keep their values.",
      "arguments": {"SCHEMA_ID": {"type": "STRING", "defaultValue": "sensor.reading"}, "VERSION": {"type": "STRING", "defaultValue": "1.0.0"}},
      "resultType": "void", "effect": "state", "immutable": true, "errors": ["INVALID_SCHEMA", "SCHEMA_NOT_FOUND"],
      "server": {"supported": true, "irOperation": "structuredData.deleteSchema"}
    },
    {
      "opcode": "parseJsonWithSchema", "blockType": "COMMAND", "text": "parse JSON [TEXT] as [NAME] with schema [SCHEMA_ID] version [VERSION]", "description": "Parse JSON text and bind it only when it matches the named Schema.",
      "arguments": {"TEXT": {"type": "STRING", "defaultValue": "{\"name\":\"TurboWarp\"}"}, "NAME": {"type": "STRING", "defaultValue": "data"}, "SCHEMA_ID": {"type": "STRING", "defaultValue": "sensor.reading"}, "VERSION": {"type": "STRING", "defaultValue": "1.0.0"}},
      "resultType": "void", "effect": "state", "immutable": true, "errors": ["INVALID_JSON", "INVALID_NAME", "PARSE_LIMIT_EXCEEDED", "INVALID_SCHEMA", "SCHEMA_NOT_FOUND", "SCHEMA_VALIDATION_FAILED"],
      "server": {"supported": true, "irOperation": "structuredData.parseJsonWithSchema"}
    },
    {
      "opcode": "parseYamlWithSchema", "blockType": "COMMAND", "text": "parse YAML [TEXT] as [NAME] with schema [SCHEMA_ID] version [VERSION]", "description": "Parse safe YAML text and bind it only when it matches the named Schema.",
      "arguments": {"TEXT": {"type": "STRING", "defaultValue": "name: TurboWarp"}, "NAME": {"type": "STRING", "defaultValue": "data"}, "SCHEMA_ID": {"type": "STRING", "defaultValue": "sensor.reading"}, "VERSION": {"type": "STRING", "defaultValue": "1.0.0"}},
      "resultType": "void", "effect": "state", "immutable": true, "errors": ["INVALID_YAML", "INVALID_NAME", "PARSE_LIMIT_EXCEEDED", "INVALID_SCHEMA", "SCHEMA_NOT_FOUND", "SCHEMA_VALIDATION_FAILED"],
      "server": {"supported": true, "irOperation": "structuredData.parseYamlWithSchema"}
    },
    {
      "opcode": "schemaOf", "blockType": "REPORTER", "text": "schema of [NAME]", "description": "Return the schemaRef bound to named data as JSON, or an empty object when it has none.",
      "arguments": {"NAME": {"type": "STRING", "defaultValue": "data"}},
      "resultType": "jsonText", "effect": "pure", "immutable": true, "errors": ["INVALID_NAME", "DATA_NOT_FOUND"],
      "server": {"supported": true, "irOperation": "structuredData.schemaOf"}
    }
  ]
}
