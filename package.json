{
  "name": "@kubohiroya/turbowarp-structured-data",
  "version": "0.11.0-rc.1",
  "description": "Named structured data with JSON/YAML codecs and deterministic path operations for TurboWarp.",
  "author": {
    "name": "Hiroya Kubo",
    "email": "hiroya@cuc.ac.jp",
    "url": "https://github.com/kubohiroya"
  },
  "license": "MPL-2.0",
  "homepage": "https://github.com/kubohiroya/turbowarp-structured-data#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kubohiroya/turbowarp-structured-data.git"
  },
  "bugs": {
    "url": "https://github.com/kubohiroya/turbowarp-structured-data/issues"
  },
  "keywords": [
    "turbowarp",
    "scratch",
    "extension",
    "structured-data",
    "json",
    "yaml",
    "vite",
    "typescript"
  ],
  "type": "module",
  "files": [
    "dist/",
    "docs/",
    "src/",
    "schemas/",
    "templates/",
    "README.md",
    "README.ja.md",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE",
    "lib-editor/",
    "lib-module/",
    "assets/block-icon.svg",
    "lib-source/"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "tag": "next"
  },
  "packageManager": "pnpm@11.28.8",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "build": "vite build && pnpm run build:editor && pnpm run build:module && pnpm run build:source",
    "lint": "eslint src tests scripts vite.config.ts vite.editor.config.ts eslint.config.ts vite.module.config.ts",
    "test": "vitest run",
    "docs": "node scripts/generate-readme.ts && node scripts/generate-fixed-input-docs.mjs",
    "docs:check": "node scripts/generate-readme.ts --check && node scripts/generate-fixed-input-docs.mjs --check",
    "template:readme": "node scripts/apply-readme-template.ts",
    "repo:check": "node scripts/check-repo.ts",
    "pack:check": "npm pack --dry-run --ignore-scripts",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run docs:check && pnpm run check:dist && pnpm run check:module && pnpm run repo:check && pnpm run pack:check && pnpm run samples:check",
    "check:dist": "pnpm run build && node scripts/check-dist.ts",
    "build:editor": "tsc -p tsconfig.editor.json && vite build --config vite.editor.config.ts",
    "build:module": "tsc -p tsconfig.module.json && vite build --config vite.module.config.ts",
    "check:module": "node scripts/check-bundle-module.ts",
    "samples:build": "node scripts/build-samples.mjs",
    "samples:check": "node scripts/build-samples.mjs --check && node --test scripts/verify-samples.mjs",
    "pages:build": "node scripts/prepare-pages.mjs",
    "build:source": "tsc -p tsconfig.source.json"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@kubohiroya/turbowarp-extension-manifest": "^0.5.0",
    "@kubohiroya/turbowarp-named-data": "0.8.0-rc.0",
    "@kubohiroya/vite-plugin-turbowarp-extension": "^0.10.0",
    "@types/node": "^24.13.3",
    "eslint": "^9.39.5",
    "jiti": "^2.7.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0",
    "react-dom": "18.3.1",
    "@kubohiroya/turbowarp-extension-data-editor": "^0.5.0"
  },
  "dependencies": {
    "@kubohiroya/turbowarp-yaml-json": "0.8.0-rc.0",
    "@kubohiroya/turbowarp-document-data": "0.5.0-rc.2",
    "@kubohiroya/turbowarp-named-functions": "0.4.1-rc.1"
  },
  "peerDependencies": {
    "@kubohiroya/turbowarp-named-data": "0.8.0-rc.0"
  },
  "exports": {
    "./*": "./*",
    "./editor-metadata": {
      "types": "./lib-editor/src/editor-metadata.d.ts",
      "import": "./lib-editor/src/editor-metadata.js"
    },
    "./bundle-module": {
      "types": "./lib-module/src/bundle-module.d.ts",
      "import": "./lib-module/src/bundle-module.js"
    },
    "./document-source": {
      "types": "./lib-source/document-source.d.ts",
      "import": "./lib-source/document-source.js"
    }
  }
}
